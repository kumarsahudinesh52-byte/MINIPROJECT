<section class="home-section">

    <h2>🏷️ Deals you don't want to miss</h2>

    <p class="section-subtitle">
        Save more on your next adventure
    </p>

    <div class="row g-4">

        <% if (allListings && allListings.length > 0) { %>

            <% allListings.slice(0, 3).forEach((listing, index) => { %>

                <div class="col-lg-4 col-md-6">

                    <div class="deal-card">

                        <!-- IMAGE -->
                        <img
                            src="<%= listing.image.url %>"
                            class="w-100"
                            alt="<%= listing.title %>"
                        >

                        <div class="deal-body">

                            <!-- DISCOUNT -->
                            <span class="discount-tag">
                                <%= [30, 25, 20][index] %>% OFF
                            </span>

                            <!-- TITLE -->
                            <h4>
                                <%= listing.title %>
                            </h4>

                            <!-- DESCRIPTION -->
                            <p class="text-muted">
                                <%= listing.description %>
                            </p>

                            <!-- PRICE -->
                            <div class="price-box">

                                <span class="old-price">
                                    ₹<%= Math.round(
                                        listing.price /
                                        (1 - [30, 25, 20][index] / 100)
                                    ).toLocaleString("en-IN") %>
                                </span>

                                <span class="new-price">
                                    ₹<%= listing.price.toLocaleString("en-IN") %>
                                    / night
                                </span>

                            </div>

                            <!-- LOCATION -->
                            <p class="text-muted mt-2">
                                📍 <%= listing.location %>,
                                <%= listing.country %>
                            </p>

                            <!-- SHOW LISTING -->
                            <a
                                href="/listings/<%= listing._id %>"
                                class="deal-btn"
                            >
                                View Stay
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="col-12">
                <p class="text-muted">
                    No deals available right now.
                </p>
            </div>

        <% } %>

    </div>

</section>

