<% layout("/layouts/boilerplate") %>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #fff;
    }

    /* ================= NAVBAR ================= */

    .home-navbar {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: white;
        border-bottom: 1px solid #eee;
        padding: 12px 5%;
    }

    .home-brand {
        font-size: 28px;
        font-weight: 700;
        color: #ff385c;
        text-decoration: none;
    }

    .home-brand:hover {
        color: #e31c5f;
    }

    .home-nav-link {
        color: #333 !important;
        font-weight: 500;
        margin: 0 8px;
    }

    .home-nav-link:hover {
        color: #ff385c !important;
    }

    .home-search {
        border: 1px solid #ddd;
        border-radius: 30px;
        padding: 6px;
        background: white;
    }

    .home-search input {
        border: none;
        outline: none;
        padding: 8px 15px;
        width: 180px;
    }

    .home-search button {
        border: none;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        background: #ff385c;
        color: white;
    }

    /* ================= DISCOUNT BANNER ================= */

    .discount-banner {
        background: linear-gradient(90deg, #ff385c, #ff6b81);
        color: white;
        padding: 12px;
        text-align: center;
        font-weight: 600;
    }

    .discount-banner span {
        background: white;
        color: #ff385c;
        padding: 5px 12px;
        border-radius: 20px;
        margin-left: 10px;
    }

    /* ================= HERO ================= */

    .hero-section {
        height: 600px;
        position: relative;
        background:
            linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)),
            url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1800&q=80");
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .hero-content {
        color: white;
        max-width: 850px;
        padding: 20px;
    }

    .hero-content h1 {
        font-size: 60px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    .hero-content p {
        font-size: 22px;
        margin-bottom: 30px;
    }

    .hero-search {
        background: white;
        padding: 8px;
        border-radius: 50px;
        display: flex;
        max-width: 650px;
        margin: auto;
    }

    .hero-search input {
        flex: 1;
        border: none;
        outline: none;
        padding: 15px 20px;
        border-radius: 50px;
        font-size: 16px;
    }

    .hero-search button {
        border: none;
        background: #ff385c;
        color: white;
        border-radius: 40px;
        padding: 0 28px;
        font-weight: 600;
    }

    /* ================= SECTION ================= */

    .home-section {
        padding: 55px 5%;
    }

    .home-section h2 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .section-subtitle {
        color: #777;
        margin-bottom: 30px;
    }

    /* ================= MOVING CARDS ================= */

    .slider-wrapper {
        overflow: hidden;
        width: 100%;
    }

    .moving-cards {
        display: flex;
        gap: 22px;
        width: max-content;
        animation: moveCards 28s linear infinite;
    }

    .moving-cards:hover {
        animation-play-state: paused;
    }

    @keyframes moveCards {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .destination-card {
        width: 270px;
        flex-shrink: 0;
        border-radius: 18px;
        overflow: hidden;
        position: relative;
        height: 330px;
        cursor: pointer;
        box-shadow: 0 5px 18px rgba(0,0,0,.12);
    }

    .destination-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: .4s;
    }

    .destination-card:hover img {
        transform: scale(1.08);
    }

    .destination-info {
        position: absolute;
        bottom: 0;
        width: 100%;
        padding: 25px 18px 18px;
        color: white;
        background: linear-gradient(transparent, rgba(0,0,0,.8));
    }

    .destination-info h4 {
        margin: 0;
        font-weight: 700;
    }

    .destination-info p {
        margin: 5px 0 0;
    }

    /* ================= DEAL CARDS ================= */

    .deal-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0,0,0,.1);
        transition: .3s;
        height: 100%;
    }

    .deal-card:hover {
        transform: translateY(-7px);
    }

    .deal-card img {
        height: 220px;
        object-fit: cover;
    }

    .deal-body {
        padding: 20px;
    }

    .discount-tag {
        display: inline-block;
        background: #ff385c;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 10px;
    }

    .old-price {
        text-decoration: line-through;
        color: #888;
    }

    .new-price {
        font-size: 20px;
        font-weight: 700;
    }

    /* ================= CATEGORIES ================= */

    .category-box {
        text-decoration: none;
        color: #222;
        text-align: center;
        padding: 25px 10px;
        border: 1px solid #eee;
        border-radius: 18px;
        transition: .3s;
        display: block;
    }

    .category-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 18px rgba(0,0,0,.1);
        color: #ff385c;
    }

    .category-box i {
        font-size: 32px;
        margin-bottom: 12px;
    }

    .category-box h5 {
        margin: 0;
    }

    /* ================= BIG OFFER ================= */

    .big-offer {
        margin: 30px 5%;
        min-height: 350px;
        border-radius: 25px;
        background:
            linear-gradient(90deg, rgba(0,0,0,.75), rgba(0,0,0,.15)),
            url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80");
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        padding: 50px;
        color: white;
    }

    .big-offer-content {
        max-width: 500px;
    }

    .big-offer h2 {
        font-size: 45px;
        font-weight: 800;
    }

    .offer-btn {
        display: inline-block;
        background: #ff385c;
        color: white;
        padding: 13px 25px;
        border-radius: 30px;
        text-decoration: none;
        margin-top: 15px;
        font-weight: 600;
    }

    /* ================= FOOTER ================= */

    .home-footer {
        background: #f7f7f7;
        padding: 50px 5% 25px;
        margin-top: 50px;
    }

    .footer-title {
        font-weight: 700;
        margin-bottom: 18px;
    }

    .home-footer a {
        display: block;
        text-decoration: none;
        color: #666;
        margin-bottom: 10px;
    }

    .home-footer a:hover {
        color: #ff385c;
    }

    .footer-bottom {
        border-top: 1px solid #ddd;
        margin-top: 30px;
        padding-top: 20px;
        text-align: center;
        color: #777;
    }

    /* ================= MOBILE ================= */

    @media (max-width: 768px) {

        .hero-content h1 {
            font-size: 40px;
        }

        .hero-content p {
            font-size: 17px;
        }

        .hero-section {
            height: 520px;
        }

        .home-search {
            display: none;
        }

        .big-offer {
            padding: 35px;
        }

        .big-offer h2 {
            font-size: 32px;
        }
    }
</style>


